FROM python:3.12.11-alpine3.22

ARG G2P_REF=develop

RUN apk add --no-cache --virtual .build-deps gcc libc-dev linux-headers make \
 && apk add --no-cache bash git gettext libpq-dev libffi-dev openssl-dev

WORKDIR /app

# Install all Python packages in one layer for better caching and speed
# Use --parallel-builds for faster git cloning and building
RUN pip install --upgrade pip setuptools && \
    pip install --disable-pip-version-check \
        git+https://github.com/openg2p/openg2p-fastapi-common@v1.1.4\#subdirectory=openg2p-fastapi-common  \
        git+https://github.com/openg2p/openg2p-fastapi-common@v1.1.4\#subdirectory=openg2p-fastapi-auth \
        git+https://github.com/openg2p/openg2p-g2pconnect-common-lib@v2.0.0\#subdirectory=openg2p-g2pconnect-common-lib \
        "git+https://github.com/openg2p/openg2p-registry-gen2-core@${G2P_REF}#subdirectory=openg2p-registry-core" \
        "git+https://github.com/openg2p/openg2p-registry-gen2-celery@${G2P_REF}#subdirectory=openg2p-registry-celery-beat-producers"

# Clean up build dependencies early to reduce image size
RUN apk del --no-network .build-deps

ENV PYTHONUNBUFFERED=1

# Use module path for Celery beat app
CMD ["celery", "-A", "openg2p_registry_celery_beat_producers.main.celery_app", "worker", "--beat", "--loglevel=info", "--schedule=/tmp/celery-beat-schedule.db"]